scripts/*.json

# Aggregated results written by notebooks/02_monte_carlo_fiber_strength.ipynb across many
# scripts/build_fiber_tension.py invocations -- same kind of regenerated artifact, just
# accumulated notebook-side instead of by the script itself.
scripts/*.csv

# Per-run full history JSON, one file per Monte Carlo sample, written into a campaign
# subdirectory by notebooks/02_monte_carlo_fiber_strength.ipynb (scripts/mc_runs_off/,
# scripts/mc_runs_on/) -- nested one level deeper than scripts/*.json above, so needs its
# own pattern; same regenerated-output rationale.
scripts/mc_runs*/

# Python bytecode cache directories
scripts/__pycache__/

# Literature sources
sources/