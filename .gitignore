# Debugging scripts
scripts/inspect_*.py

# Every Monte Carlo campaign's output -- per-run full history JSON, summary CSV, and timing
# JSON -- written under its own notebooks/<nb>-numbered subfolder (runs/nb02/, runs/nb03/,
# runs/nb04/) by that notebook (or its standalone background driver script). Regenerated
# output, not source; kept out of scripts/ so results never mix with code.
runs/

# Python bytecode cache directories and notebook checkpoints
scripts/__pycache__/
*.pyc
__pycache__/
.ipynb_checkpoints/

# Literature sources
sources/